{
  "manifest_version": 3,
  "name": "Story Bookmark Updater",
  "version": "1.1",
  "description": "Updates existing story bookmarks to the current page, preserving custom titles and stripping tracking links.",
  "permissions": [
    "bookmarks",
    "activeTab",
    "tabs"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "story-bookmark-updater@qchronod"
    }
  }
}
