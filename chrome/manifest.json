{
  "manifest_version": 3,
  "name": "Story Bookmark Updater",
  "version": "1.1", 
  "description": "Updates existing story bookmarks to the current page, preserving custom titles and stripping tracking links.",
  "permissions": [
    "bookmarks",
    "activeTab",
    "tabs"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png" 
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}